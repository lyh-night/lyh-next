{
  "name": "lyh-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter @lyh-next/frontend run dev",
    "dev:backend": "pnpm --filter @lyh-next/backend run dev",
    "start": "pnpm --filter @lyh-next/frontend run start",
    "start:backend": "pnpm --filter @lyh-next/backend run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "generate": "pnpm --filter @lyh-next/frontend run generate",
    "db:push": "pnpm --filter @lyh-next/frontend run db:push",
    "db:studio": "pnpm --filter @lyh-next/frontend run db:studio",
    "prepare": "husky",
    "postinstall": "pnpm --filter @lyh-next/frontend run generate"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@next/eslint-plugin-next": "^15.4.7",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.11.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
