{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_COOKIE_NAME",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_API_URL",
    "BACKEND_URL"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "prettier.config.js",
    "pnpm-lock.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
