# 服务端口（前端占用 3000，后端默认 3001）
PORT=3001

# 运行环境：development | production
NODE_ENV=development

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:3000

# PostgreSQL 连接串（compose 的 db 映射到宿主机 6432）
DATABASE_URL="postgresql://postgres:postgres@localhost:6432/lyh-next-db"

# 会话 JWT 签名密钥（必填），生成：openssl rand -base64 32
# 必须与 apps/frontend 的 AUTH_SECRET 完全一致
AUTH_SECRET=""

# 会话有效期，支持 7d / 12h / 3600 这类写法
AUTH_TOKEN_TTL=7d

# 会话 cookie 名称（需与前端一致）
AUTH_COOKIE_NAME=auth_token
